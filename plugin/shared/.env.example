# Shared settings of the loop (model). Copy to one of these places and fill in; the first file that defines a key wins:
#   1. the file in LOOP_ENV_FILE (when set, ONLY that file is read)
#   2. ~/.loop-harness/.env (the Loop Harness app's data folder; LOOP_DATA_DIR replaces ~/.loop-harness) - recommended,
#      it survives plugin updates
#   3. <plugin>/shared/.env (next to this file)
# `.env` must NEVER be committed (only this .env.example is). Real environment variables take priority over `.env`.
# Quote values with special characters (# & % { } ? ^) using single quotes.

# --- Loop notifications (`python <app>/harness.py notify`; `--test` checks every channel) ---
# Comma-separated channels: console, toast, file, email, webhook. A channel without configuration is skipped.
LOOP_NOTIFY_CHANNELS=console,toast,file
# Channels that MUST be delivered (comma-separated; empty = none). The loop pre-flight refuses to start if one is not configured.
LOOP_NOTIFY_REQUIRED=
# Who receives the email notification (comma-separated).
LOOP_NOTIFY_TO=you@example.com

# --- email channel (generic SMTP) ---
LOOP_SMTP_HOST=smtp.example.com
LOOP_SMTP_PORT=587
LOOP_SMTP_USER=you@example.com
LOOP_SMTP_PASSWORD=''
LOOP_SMTP_FROM=loop@example.com
# starttls | ssl | none
LOOP_SMTP_SECURITY=starttls

# --- webhook channel (POST JSON: subject, body, event, project) ---
LOOP_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# --- Panel (the app's local web page) ---
# off = the loop does not start or reuse the panel (same as --no-monitor).
LOOP_MONITOR=
# off = the panel still starts, but the browser is not opened.
LOOP_MONITOR_OPEN=

# --- Git / delivery ---
# Branch that receives the final pull request (default: developer). Never pushed to directly.
LOOP_INTEGRATION_BRANCH=developer
# Git account required on the loop's final push. Empty = any configured git identity.
LOOP_GIT_USER=
# PR mode: auto (gh pr create), link (compare link only), off (no PR). LOOP_PR_DRAFT=1 opens it as draft.
LOOP_PR_MODE=auto
LOOP_PR_DRAFT=

# --- Guard (skills/orchestrator/hooks/guard.py) ---
# Comma-separated substrings that mark an MCP tool as production (write tools matching them are blocked).
GUARD_PROD_HINTS=prod,production

# Alias of LOOP_INTEGRATION_BRANCH (takes priority when set).
LOOP_PR_BASE=

# --- Test credentials (convention shared by every skill; `python <plugin>/shared/testenv.py list|check|exec`) ---
# VALUES only here (or in <project>/.specs/project/.env.test), never in a markdown file. Only DEV accounts.
# The first file that defines a name wins: <project>/.specs/project/.env.test > ~/.loop-harness/.env > shared/.env.
# Test users: `;`-separated lists aligned by position (write \; for a literal ;). Each becomes TEST_USER_<n>_EMAIL/_PASSWORD/_ROLE.
# TEST_USER_EMAILS=first@company.com;second@company.com
# TEST_USER_PASSWORDS=
# TEST_USER_ROLES=customer;admin
