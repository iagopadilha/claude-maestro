# Loop Harness settings (model). Copy to `~/.loop-harness/.env` (or `<LOOP_DATA_DIR>/.env`) and fill in.
# `.env` is a secret: it NEVER goes to the repository (only this .env.example does).
# Lookup order (harness_backend/config/envload.py):
#   1. LOOP_ENV_FILE (explicit file: only that one is read)
#   2. ~/.loop-harness/.env  (or LOOP_DATA_DIR/.env)
#   3. <plugin>/shared/.env  (the plugin that holds the orchestrator skill)
# Without an explicit file, 2 and 3 are merged (the first one that defines a key wins). A real environment variable beats the .env.
# Quote values with special characters (# & % { } ? ^) using single quotes.

# --- Loop notifications (engine/notify.py; test: python harness.py notify --test) ---
# Comma-separated channels: console, toast, file, email, webhook. A channel without configuration is skipped.
LOOP_NOTIFY_CHANNELS=console,toast,file
# MANDATORY channels (comma-separated; the preflight refuses to start if one is not configured). Unset or empty = none.
# LOOP_NOTIFY_REQUIRED=toast,email
# Who receives the email notification (comma-separated).
LOOP_NOTIFY_TO=you@example.com

# --- email channel (generic SMTP) ---
LOOP_SMTP_HOST=smtp.example.com
LOOP_SMTP_PORT=587
LOOP_SMTP_USER=you@example.com
# Secret: only here, never in a repository.
LOOP_SMTP_PASSWORD=''
LOOP_SMTP_FROM=someone@example.com
# starttls | ssl | none
LOOP_SMTP_SECURITY=starttls

# --- webhook channel (POST JSON: subject, body, event, project) ---
# LOOP_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# --- Git / delivery at the end of the loop (engine/delivery.py) ---
# Branch that receives the final pull request (default: developer). It is never pushed to directly.
# LOOP_INTEGRATION_BRANCH=developer
# Alias of LOOP_INTEGRATION_BRANCH (wins when set).
# LOOP_PR_BASE=
# Git account required on the loop's push. Empty = any configured git identity.
LOOP_GIT_USER=
# PR mode: auto (gh pr create), link (compare link only), off (no PR). LOOP_PR_DRAFT=1 opens it as a draft.
# LOOP_PR_MODE=auto
# LOOP_PR_DRAFT=

# --- Guard (plugin skills/orchestrator/hooks/guard.py) and the loop's permission denials ---
# Comma-separated words that mark production: MCP write tools matching them are blocked by the guard, and a denied
# command that mentions one of them always stops the loop.
# GUARD_PROD_HINTS=prod,production

# --- Panel (app) ---
# off = the loop does not start or register the panel (same as --no-monitor on every loop).
# LOOP_MONITOR=on
# off = the app starts without opening the browser.
# LOOP_MONITOR_OPEN=on

# --- Paths (usually only as environment variables, not in the .env) ---
# LOOP_DATA_DIR   app data folder (default ~/.loop-harness): config.json, projects.json, app.json, .env, logs/
# LOOP_SKILL_DIR  orchestrator skill folder (default: config.json `orchestrator_skill_dir`, then the plugin next to the
#                 app in this clone, then the installed plugin)
# LOOP_ENV_FILE   explicit .env (replaces the lookup above)
